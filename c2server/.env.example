# ==============================
# Server Configuration
# ==============================

# Host the server listens on
C2_SERVER_HOST=0.0.0.0

# Main server port
C2_SERVER_PORT=9100

# WebSocket port
C2_SERVER_WS_PORT=876

# ==============================
# Redis Configuration
# ==============================

# Redis server host
C2_SERVER_REDIS_HOST=localhost

# (Optional) Redis password
C2_SERVER_REDIS_PASSWORD=

# Redis database index
C2_SERVER_REDIS_DB=0

# ==============================
# SSL/TLS Configuration
# Provide full file paths to cert/key if SSL is enabled
# ==============================

# (Optional) Path to SSL certificate (e.g., /etc/ssl/certs/cert.pem)
C2_SERVER_SSL_CERT=

# (Optional) Path to SSL private key (e.g., /etc/ssl/private/key.pem)
C2_SERVER_SSL_KEY=
