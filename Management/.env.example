# Example environment variables for the Management FastAPI backend

# PostgreSQL connection settings
DB_NAME=default_db_name
DB_USER=default_user
# DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# JWT signing secret
MANAGEMENT_SECRET_KEY=change-me

# Enable debug mode (True/False)
MANAGEMENT_DEBUG=False

# Allowed CORS origins as a comma separated list
MANAGEMENT_CORS_ORIGINS=http://localhost:3000

# Token expiration settings
MANAGEMENT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
MANAGEMENT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=9
MANAGEMENT_JWT_ISSUER=management
MANAGEMENT_JWT_AUDIENCE=management-client

# Redis connection used for background tasks
MANAGEMENT_REDIS_HOST=redis
MANAGEMENT_REDIS_PORT=6379
MANAGEMENT_REDIS_PASSWORD=
MANAGEMENT_ARQ_REDIS_DB=4

# Database used by the test suite
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/test_db
