MANAGEMENT_JWT_AUDIENCE=darkscry-frontend
MANAGEMENT_REDIS_HOST=redis
MANAGEMENT_REDIS_PORT=6379
# MANAGEMENT_REDIS_PASSWORD=
MANAGEMENT_ARQ_REDIS_DB=4

#######################################
# Frontend
#######################################
