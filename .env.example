# DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

#######################################
# Redis
#######################################
REDIS_HOST=redis
# REDIS_PASSWORD=

#######################################
# C2 Server
#######################################
C2_SERVER_HOST=0.0.0.0
C2_SERVER_PORT=9100
C2_SERVER_WS_PORT=876
C2_SERVER_REDIS_HOST=redis
# C2_SERVER_REDIS_PASSWORD=
C2_SERVER_REDIS_DB=0
