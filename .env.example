####################################
#        Redis Configuration       #
####################################
REDIS_HOST=redis
REDIS_PASSWORD=redissrv2025!


####################################
#      C2 Server Configuration     #
####################################
C2_SERVER_HOST=0.0.0.0
C2_SERVER_PORT=876
C2_SERVER_REDIS_DB=3
# Path to the private key used by the C2 Server
# PRIVATE_KEY_PATH=/etc/DarkScryC2Server/private.key




####################################
#    Database Configuration         #
####################################
DB_NAME=default_db_name
DB_USER=default_user
# DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

####################################
#   Management Configuration        #
####################################
# PostgreSQL connection string used by the FastAPI backend
# Built dynamically from the database settings above
MANAGEMENT_DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
MANAGEMENT_SECRET_KEY=change-me
MANAGEMENT_DEBUG=False
MANAGEMENT_CORS_ORIGINS=http://localhost:3000
MANAGEMENT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
MANAGEMENT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=9
MANAGEMENT_JWT_ISSUER=management
MANAGEMENT_JWT_AUDIENCE=management-client
MANAGEMENT_REDIS_HOST=${REDIS_HOST}
MANAGEMENT_REDIS_PORT=6379
MANAGEMENT_REDIS_PASSWORD=${REDIS_PASSWORD}
MANAGEMENT_ARQ_REDIS_DB=4
