#######################################
# Management API
#######################################
MANAGEMENT_SECRET_KEY=change-me
MANAGEMENT_DEBUG=True
MANAGEMENT_CORS_ORIGINS=http://localhost:3000
MANAGEMENT_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
MANAGEMENT_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
